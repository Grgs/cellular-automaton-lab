{
    "name": "cellular-automaton-lab",
    "private": true,
    "engines": {
        "node": "22.22.2"
    },
    "overrides": {
        "rolldown": "1.2.4"
    },
    "scripts": {
        "build:frontend": "vite build --mode server",
        "build:frontend:server": "vite build --mode server",
        "build:frontend:standalone": "node ./tools/internal/python_tools_entry.mjs build standalone",
        "build:standalone-and-test": "npm run test:e2e:playwright:standalone",
        "dev:frontend": "vite build --watch --mode server",
        "format:frontend": "prettier --write \"frontend/**/*.{ts,d.ts,html}\" \"frontend/**/*.css\" \"static/css/**/*.css\" \"templates/**/*.html\" \"vite.config.ts\" \"tools/internal/*.mjs\" \"*.{json,mjs}\"",
        "format:frontend:check": "prettier --check \"frontend/**/*.{ts,d.ts,html}\" \"frontend/**/*.css\" \"static/css/**/*.css\" \"templates/**/*.html\" \"vite.config.ts\" \"tools/internal/*.mjs\" \"*.{json,mjs}\"",
        "format:python:check": "node ./tools/internal/python_tools_entry.mjs repo python-style format-check",
        "lint:frontend": "npm run typecheck:frontend && npm run lint:frontend:eslint && npm run format:frontend:check",
        "lint:frontend:eslint": "oxlint --deny no-unused-vars \"frontend/**/*.ts\" vite.config.ts",
        "lint:python": "node ./tools/internal/python_tools_entry.mjs repo python-style check",
        "typecheck:frontend": "tsc -p tsconfig.json --noEmit",
        "typecheck:python": "node ./tools/internal/python_exec.mjs -m mypy --config-file pyproject.toml",
        "test:frontend": "node ./tools/internal/vitest_entry.mjs run",
        "test:e2e:playwright": "node ./tools/internal/python_tools_entry.mjs test e2e --suite all",
        "test:e2e:playwright:compare-workbench": "npm run build:frontend && node ./tools/internal/python_tools_entry.mjs test e2e --suite compare_workbench",
        "test:e2e:playwright:server": "node ./tools/internal/python_tools_entry.mjs test e2e --suite server",
        "test:e2e:playwright:subset": "node ./tools/internal/python_tools_entry.mjs test e2e --suite subset",
        "test:e2e:playwright:standalone": "node ./tools/internal/python_tools_entry.mjs test e2e --suite standalone",
        "check:dead-code": "node ./tools/internal/python_tools_entry.mjs repo dead-code",
        "check:python": "npm run lint:python && npm run format:python:check && npm run typecheck:python && npm run check:dead-code",
        "check:frontend": "npm run lint:frontend && npm run build:frontend && npm run test:frontend",
        "check:e2e": "npm run typecheck:frontend && npm run build:frontend && npm run test:e2e:playwright",
        "check:privacy": "node ./tools/internal/python_tools_entry.mjs security privacy --all-files",
        "check:ci-local": "npm run check:privacy && npm run check:python && npm run check:frontend && npm run check:bundle-size:fresh && node ./tools/internal/python_tools_entry.mjs tilings validate && node ./tools/internal/python_tools_entry.mjs tilings verify && npm run test:e2e:playwright",
        "fixtures:reference:check": "node ./tools/internal/python_tools_entry.mjs fixtures reference --all --mode both --check",
        "audit:supply-chain": "node ./tools/internal/python_tools_entry.mjs security supply-chain",
        "coverage:backend": "node ./tools/internal/python_tools_entry.mjs test coverage --fail-under 75",
        "coverage:frontend": "node ./tools/internal/vitest_entry.mjs run --coverage",
        "check:bundle-size": "node ./tools/internal/python_tools_entry.mjs build bundle-size",
        "check:bundle-size:fresh": "npm run build:frontend:standalone && npm run check:bundle-size",
        "smoke:standalone": "node ./tools/internal/python_tools_entry.mjs browser smoke-standalone",
        "check:doc-links": "node ./tools/internal/check_doc_links.mjs",
        "dependencies:update": "node ./tools/internal/python_tools_entry.mjs dependencies update",
        "check:dependencies": "node ./tools/internal/python_tools_entry.mjs dependencies check --audit && npm run check:python && npm run check:frontend && npm run check:bundle-size:fresh"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "@vitest/coverage-v8": "^4.1.10",
        "htmlparser2": "^12.0.0",
        "jsdom": "^30.0.1",
        "marked": "^18.0.9",
        "marked-gfm-heading-id": "^4.1.4",
        "match-sorter": "^8.3.0",
        "oxlint": "^1.78.0",
        "polygon-clipping": "^0.15.7",
        "prettier": "^3.9.6",
        "pyodide": "314.0.3",
        "typescript": "^7.0.2",
        "vite": "^8.2.1",
        "vitest": "^4.1.10"
    }
}
